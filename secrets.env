# Kaggle GPU-as-a-Service Secrets Configuration
# Copy this file to kaggle_secrets.env and fill in your values
# Or set these as Kaggle Secrets in your notebook (Add-ons → Secrets)

# ngrok Authentication Token (for HTTPS tunnel)
# Get yours at: https://dashboard.ngrok.com/get-started/your-authtoken
export NGROK_AUTHTOKEN="1qb36HRiTApsnt5IVQ1bDWAbdk7_5snrnJJ8eBdxbZxhP625f"

# ComfyUI Basic Auth Password (for securing the web interface)
# Choose any strong password - this protects your ngrok tunnel
export COMFYUI_AUTH_PASSWORD="MyKagglePass2026!"

# Optional: HuggingFace token for gated models
# export HF_TOKEN="your_hf_token_here"

# Deployment Mode: single (default) or multi (multiple Kaggle accounts)
# export KGPU_MODE="single"